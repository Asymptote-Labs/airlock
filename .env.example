OPENAI_API_KEY=
AIRLOCK_MODEL=gpt-6-astra
AIRLOCK_STATE_DIR=.airlock
AIRLOCK_BROKER_URL=http://127.0.0.1:8100
# Use 2026-09-10 for the seeded demo; omit to use today's UTC date.
AIRLOCK_DEMO_DATE=2026-09-10
# CLI client credentials (generated by airlock init; never commit them):
AIRLOCK_ADMIN_TOKEN=
AIRLOCK_AGENT_TOKEN=
# MCP file access root (defaults to the adapter working directory):
AIRLOCK_AGENT_WORKSPACE=
